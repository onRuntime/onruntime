{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/validate-commit.mjs"],
            "timeout": 10,
            "statusMessage": "Checking the commit message..."
          }
        ]
      }
    ]
  }
}
